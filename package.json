{
  "name": "dsh-apollo",
  "version": "0.2.0",
  "description": "DSH plugin: \u628a\u5927\u4efb\u52a1\u62c6\u6210\u53ef\u72ec\u7acb\u9a8c\u8bc1\u7684\u5b50\u4efb\u52a1\u5e76\u884c\u6267\u884c\uff0c\u6bcf\u4e2a\u8282\u70b9\u5185\u7f6e\u5b50\u4ee3\u7406\u5ba1\u67e5\uff0c\u9a8c\u8bc1\u901a\u8fc7\u624d\u5408\u5165\uff1b\u53e6\u542b\u5e26\u9000\u51fa\u5b88\u536b\u7684 eng\uff08\u5de5\u7a0b\u6a21\u5f0f\uff09\u9884\u8bbe\u3002\u96f6\u4f9d\u8d56\u3001\u65e0\u6784\u5efa\u3002",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "src",
    "skills",
    "presets",
    "third-party",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "workflow",
    "orchestration",
    "agent-preset"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
